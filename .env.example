# Razorpay Payment Gateway Live / Test Key ID
# Get this from Razorpay Dashboard > Settings > API Keys
# Example: rzp_live_xxxxxxxxxxxx or rzp_test_xxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_test_1DP5mmOlF5G5ag

# Production Canonical Site URL
VITE_SITE_URL=https://zoyara.vercel.app

# Live Cloud Database (Supabase) — Free Real-time PostgreSQL
# Get from Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Analytics 4 Measurement ID (Optional)
VITE_GA_ID=G-ZOYARA2026
